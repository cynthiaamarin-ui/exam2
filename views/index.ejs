
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UTRGV Tutoring Hub</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <header>
        <h1>UTRGV Tutoring Hub</h1>

        <nav>
            <a href="/">Home</a>
            <a href="/tutors">Find Tutors</a>
            <a href="/register">Register</a>
            <a href="/appointments">Appointments</a>
            <a href="/feedback">Feedback</a>
        </nav>
    </header>

    <main>
        <section class="hero">
            <h2>Find Your Perfect Tutor at UTRGV</h2>

            <p>
                Connect with tutors, explore subjects,
                and schedule tutoring sessions.
            </p>

            <a href="/tutors" class="button">Explore Tutors</a>
            <a href="/register" class="button">Get Started</a>
        </section>

        <section class="features">
            <h2>How It Works</h2>

            <div class="feature-card">
                <h3>Find Tutors</h3>
                <p>Explore tutors and their specialties.</p>
            </div>

            <div class="feature-card">
                <h3>Book Sessions</h3>
                <p>Schedule your tutoring appointments.</p>
            </div>

            <div class="feature-card">
                <h3>Share Feedback</h3>
                <p>Share your experience with tutors.</p>
            </div>
        </section>
    </main>

    <footer>
    <%- include("partials/footer") %>
    </footer>
</body>
</html>
