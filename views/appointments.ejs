
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Appointments | UTRGV Tutoring Hub</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <%- include("partials/header") %>

    <main>
        <section class="hero">
            <h2>Book a Tutoring Session</h2>
            <p>Schedule a session with a tutor and get the help you need.</p>
        </section>

        <section class="features">
            <form action="/appointments" method="POST" class="feature-card">
                <h2>Schedule an Appointment</h2>

                <label for="studentEmail">Student Email</label>
                <input type="email" id="studentEmail" name="studentEmail"
                    placeholder="Enter your registered email" required>

                <label for="tutor">Choose a Tutor</label>
                <select name="tutor" required>
    <option value="">Choose a tutor</option>

    <% tutors.forEach(tutor => { %>
        <option value="<%= tutor.name %>">
            <%= tutor.name %>
        </option>
    <% }) %>
</select>

                <label for="subject">Subject</label>
                <select id="subject" name="subject" required>
                    <option value="">Select a subject</option>
                    <option value="Mathematics">Mathematics</option>
                    <option value="Computer Science">Computer Science</option>
                    <option value="Biology">Biology</option>
                </select>

                <label for="date">Appointment Date</label>
                <input type="date" id="date" name="date" required>

                <label for="time">Appointment Time</label>
                <input type="time" id="time" name="time" required>

                <button type="submit">Book Appointment</button>
            </form>
        </section>

        <section class="features">
            <h2>Your Appointments</h2>

            <% if (appointments.length === 0) { %>
                <p>No appointments have been scheduled yet.</p>
            <% } else { %>
                <% appointments.forEach(appointment => { %>
                    <div class="feature-card">
                        <h3><%= appointment.tutor %></h3>
                        <p><strong>Student:</strong> <%= appointment.studentEmail %></p>
                        <p><strong>Subject:</strong> <%= appointment.subject %></p>
                        <p><strong>Date:</strong> <%= appointment.date %></p>
                        <p><strong>Time:</strong> <%= appointment.time %></p>
                        <p><strong>Status:</strong> <%= appointment.status %></p>

                        <% if (appointment.status === "Scheduled") { %>
                            <form action="/appointments/cancel" method="POST">
                                <input type="hidden" name="id" value="<%= appointment.id %>">
                                <button type="submit">Cancel Appointment</button>
                            </form>
                        <% } %>
                    </div>
                <% }) %>
            <% } %>
        </section>
    </main>

    <%- include("partials/footer") %>

</body>
</html>
